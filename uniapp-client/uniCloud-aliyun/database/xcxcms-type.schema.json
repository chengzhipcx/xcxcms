{
  "description": "文章分类表（客户端只读，写入走 admin 云对象）",
  "bsonType": "object",
  "required": ["title"],
  "permission": {
    "read": true,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": { "description": "ID" },
    "title": {
      "bsonType": "string",
      "title": "分类标题",
      "minLength": 1,
      "maxLength": 8
    },
    "weight": {
      "bsonType": ["int", "long", "double", "null"],
      "title": "权重（数字越小越靠前，空则按时间排序）"
    },
    "creattime": { "bsonType": "long", "title": "创建时间（毫秒时间戳）" },
    "updatetime": { "bsonType": "long", "title": "更新时间（毫秒时间戳）" }
  }
}
