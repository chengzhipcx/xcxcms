<view bindtouchstart="touchHide" bindtouchend="touchShow">
  <view class="detail">
    <view class="detail-box">
        <text class="title">{{title}}</text>
        <view>
          <text class="time">{{date}}</text>
          <text class="contactMeBtn" bindtap="modalTap">平常心cz</text>
        </view>
    </view>
    <view class="content">
      <image src="{{imgUrl}}" />
      <rich-text class="rich" nodes="{{htmlContent}}"></rich-text>
    </view>
  </view>
</view>

<!--<view class="hover-btn" catchtap="modalTap" hidden="{{btnHidden}}">
  <image src="../../images/icon.png" />
</view>-->

<modal title="关注公众号" confirm-text="关闭" hidden="{{modalHidden}}" no-cancel bindconfirm="modalHide">
    <image class="modal-gzh" src="../../images/wechat-codercheng.png" mode="widthFix"></image>
    <view class="contactMe" bindtap="copyWebsite">官网 codercheng.xyz（点击复制）</view>
</modal>
